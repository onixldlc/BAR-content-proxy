# Public URL peers reach this proxy on. Baked into rewritten repos.gz and
# /find payloads, so it must be reachable from THEIR machines.
# Leave empty to derive it from each request's Host header.
BARPROXY_PUBLIC_URL=http://bar-proxy.example.com:8080

# Listen address.
BARPROXY_ADDR=:8080

# Where cached pool files and archives live.
BARPROXY_CACHE_DIR=/var/cache/barproxy

# Evict least-recently-written objects above this size. 0 = unlimited.
# 50 GiB:
BARPROXY_CACHE_MAX_BYTES=53687091200

# Parallel range requests per object. This is the main speed lever against
# a CDN edge that throttles single connections.
BARPROXY_PARTS=4

# Objects smaller than this are fetched in one stream (8 MiB).
BARPROXY_PART_MIN_SIZE=8388608

# How long mutable control files (repos.gz, versions.gz) stay cached.
BARPROXY_MUTABLE_TTL=5m

# Extra upstream hosts to allow. Comma separated; a leading dot allows a
# whole domain. *.beyondallreason.dev and the springrts hosts are built in.
BARPROXY_ALLOW=

# Per-request logging.
BARPROXY_VERBOSE=0

# Upstream endpoints. Only change these if BAR moves its CDN, or to chain
# this proxy behind another one.
#BARPROXY_UPSTREAM_MASTER=https://repos-cdn.beyondallreason.dev/repos.gz
#BARPROXY_UPSTREAM_FIND=https://files-cdn.beyondallreason.dev/find
